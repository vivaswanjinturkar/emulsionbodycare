# Razorpay Configuration (Get keys from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Supabase Configuration (Get URL and keys from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend Email Configuration (Get key from Resend Dashboard -> API Keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Business Settings
STORE_OWNER_EMAIL=hello@emulsionbodycare.com
